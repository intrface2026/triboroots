# Resend API key used to dispatch automated no-reply sneak-peek notifications
RESEND_API_KEY=

# Sender shown in the notification email (verify domain in Resend, or use onboarding@resend.dev to test)
NOREPLY_FROM_EMAIL=TriboRoots <noreply@triboroots.com>

# Recipient inbox for visitor sneak-peek submissions
PEEK_RECIPIENT_EMAIL=teams@intrface.in

# Secret key for signing the HttpOnly triboroots_peek unlock cookie
PEEK_COOKIE_SECRET=

